# Optional — copy to .env for local deploys (never commit .env).
# Auth defaults to Wrangler login (`wrangler login`). Uncomment a token only if needed.

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Pages project name (creates <name>.pages.dev)
CF_PAGES_PROJECT=bia

# Must match the project's configured production branch
CF_PAGES_BRANCH=production

# Used in sitemap, robots.txt, llms.txt
# NUXT_PUBLIC_SITE_URL=https://bia.pages.dev
