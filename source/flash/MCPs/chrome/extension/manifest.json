{
  "manifest_version": 3,
  "name": "bia chrome",
  "version": "0.3.0",
  "description": "Passkey proxy for bia (page automation is chrome-devtools-mcp)",
  "minimum_chrome_version": "111",
  "permissions": ["tabs", "nativeMessaging", "webAuthenticationProxy", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["<all_urls>"], "all_frames": true, "match_origin_as_fallback": true, "run_at": "document_start", "world": "MAIN", "js": ["page.js"]},
    {"matches": ["<all_urls>"], "all_frames": true, "match_origin_as_fallback": true, "run_at": "document_start", "js": ["relay.js"]}
  ]
}
