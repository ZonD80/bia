[Unit]
Description=Grow the root filesystem over the whole stick and move in the flashed model
# /boot is nofail in fstab, so local-fs.target does not wait for it; models.txt lives there
Wants=boot.mount
After=local-fs.target boot.mount
Before=bia-update.service bia.service
Conflicts=shutdown.target
ConditionPathExists=/usr/local/sbin/bia-grow

[Service]
Type=oneshot
RemainAfterExit=yes
# Moving a large model in takes minutes on a USB stick; bia-grow prints progress
# on every console.
ExecStart=/usr/local/sbin/bia-grow
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
