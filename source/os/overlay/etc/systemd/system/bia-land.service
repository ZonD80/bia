[Unit]
Description=bia land installer
ConditionPathExists=/etc/bia-land-mode
After=systemd-user-sessions.service networking.service

[Service]
Type=idle
ExecStart=/usr/local/sbin/bia-land
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
