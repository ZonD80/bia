#!/bin/sh
# Visible boot progress: dhcpcd itself prints almost nothing to the console.
[ -n "$IFACE" ] || exit 0
[ "$IFACE" = lo ] && exit 0
# networking.service runs the hooks once more for "--all"
[ "$IFACE" = --all ] && exit 0
msg="bia-network: bringing up $IFACE${METHOD:+ ($METHOD)}…"
echo "$msg" >&2
[ -w /dev/console ] && echo "$msg" >/dev/console 2>/dev/null || true
exit 0
