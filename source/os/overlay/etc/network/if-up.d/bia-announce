#!/bin/sh
# Visible boot progress after the interface is configured (lease or static).
[ -n "$IFACE" ] || exit 0
[ "$IFACE" = lo ] && exit 0
addr=$(ip -4 -o addr show dev "$IFACE" scope global 2>/dev/null | awk '{ print $4; exit }')
if [ -n "$addr" ]; then
  msg="bia-network: $IFACE is up ($addr)"
else
  msg="bia-network: $IFACE is up"
fi
echo "$msg" >&2
[ -w /dev/console ] && echo "$msg" >/dev/console 2>/dev/null || true
exit 0
